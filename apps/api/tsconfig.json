{
  "extends": "../../tools/tsconfig/app.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist-types",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "dist-types"],
  "references": [
    { "path": "../../packages/core-kernel" },
    { "path": "../../packages/ports" },
    { "path": "../../packages/http-kit" }
  ]
}
