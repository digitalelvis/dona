{
  "name": "donaoferta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "donaoferta — serverless Node monorepo (API, MCP, Collector, Agent).",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint && pnpm check:deps && pnpm check:tsconfig",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:deps": "tsx tools/check-deps.ts",
    "check:tsconfig": "tsx tools/check-tsconfig.ts",
    "dev:api": "pnpm --filter @donaoferta/api dev"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "turbo": "2.3.3",
    "typescript": "5.6.3"
  }
}
