{
  "$schema": "https://turborepo.org/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "tsconfig.json",
    "tools/tsconfig/**",
    "eslint.config.js",
    "prettier.config.js",
    ".nvmrc",
    ".npmrc"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "!dist/**/*.test.*"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "outputs": []
    },
    "check:deps": {
      "outputs": []
    },
    "check:tsconfig": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
