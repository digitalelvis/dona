{
  "name": "@donaoferta/observability",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Structured logging (pino), OpenTelemetry helpers, and HTTP request logging for donaoferta apps.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --emitDeclarationOnly false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test"
  },
  "donaoferta": {
    "role": "kit"
  },
  "dependencies": {
    "@donaoferta/core-kernel": "workspace:*",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/context-async-hooks": "1.30.1",
    "@opentelemetry/resources": "1.30.1",
    "@opentelemetry/sdk-trace-base": "1.30.1",
    "@opentelemetry/semantic-conventions": "1.28.0",
    "hono": "4.12.18",
    "pino": "9.6.0"
  },
  "devDependencies": {
    "pino-pretty": "13.0.0",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
