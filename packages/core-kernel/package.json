{
  "name": "@donaoferta/core-kernel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dependency-free primitives: Result, Clock, IdGenerator, DomainError.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --emitDeclarationOnly false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test"
  },
  "donaoferta": {
    "role": "core"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "2.1.8",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
